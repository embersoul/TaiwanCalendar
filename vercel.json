{
  "version": 2,
  "builds": [
    {
      "src": "api/GetTaiwanCalendar.py",
      "use": "@vercel/python",
      "config": { "pythonVersion": "3.12" }
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/public/index.html"
    },
    {
      "src": "/api/taiwan-calendar(/(.*))?",
      "dest": "api/GetTaiwanCalendar.py"
    }
  ]
}